{
    "require": {
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8"
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/serve.php"
        ],
        "serve-lan": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/serve.php --lan"
        ],
        "db:migrate": "@php scripts/db.php migrate",
        "db:status": "@php scripts/db.php status",
        "db:baseline": "@php scripts/db.php baseline",
        "setup-tests": "@php scripts/setup-tests.php",
        "test": "@php scripts/setup-tests.php --run-tests"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    }
}

# Referência de configuração; PHP não carrega este arquivo automaticamente.
# O .env existente continua sendo utilizado pelo Docker Compose.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=refrigerador
DB_USER=refrigerador
DB_PASSWORD=senha-ficticia-substitua-no-ambiente
# Defina seu próprio segredo localmente; este valor vazio desabilita gravações.
API_WRITE_TOKEN=

# composer setup-tests usa POSTGRES_PASSWORD do .env do Compose como fallback.
# Após clonar, crie .env com POSTGRES_PASSWORD definido localmente.
# TEST_DB_* abaixo são referências para overrides no ambiente do terminal;
# não copie estes valores fictícios como credenciais de integração.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=refrigerador_test
TEST_DB_USER=usuario-ficticio-de-testes
TEST_DB_PASSWORD=senha-ficticia-de-testes
